# --- Allgemein ---
SHOP_CURRENCY=EUR

# --- EverShop / Postgres ---
EVERSHOP_PORT=3000
POSTGRES_DB=evershop
POSTGRES_USER=evershop
POSTGRES_PASSWORD=changeme_evershop_db
SESSION_SECRET=changeme_session_secret

# --- Telegram Bot ---
# Bot-Token von @BotFather anfordern (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Deine eigene Telegram Chat-ID fuer Bestell-Benachrichtigungen (z.B. via @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=000000000

# --- Plausibilitaetspruefung / Bestellsicherheit ---
# Maximale Bestellmenge pro Artikel im Warenkorb (Schutz vor Massenbestellungen von Unikaten)
MAX_QTY_PER_ITEM=5
# Mindestabstand in Sekunden zwischen Aktionen desselben Nutzers (Anti-Spam / Rate-Limiting)
RATE_LIMIT_SECONDS=0.6
